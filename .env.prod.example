# Production — Caddy auto-provisions Let's Encrypt for the domain
DOMAIN=papercrate.example.com
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me

# Secure cookies and CORS for production
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_DOMAIN=papercrate.example.com
CORS_ALLOWED_ORIGIN=https://papercrate.example.com
WEBAUTHN_RP_ID=papercrate.example.com
WEBAUTHN_ORIGIN=https://papercrate.example.com

# First user (only used on initial bootstrap)
# PAPERCRATE_INITIAL_USER=admin

# S3 credentials (defaults work with the built-in Garage instance)
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_BUCKET=documents
# AWS_REGION=garage
# RUST_LOG=info
# UPLOAD_BODY_LIMIT=128m
# WEBAUTHN_RP_NAME=Papercrate
